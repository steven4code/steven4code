# Anthropic API – optional. Ohne Key läuft automatisch die regelbasierte Analyse.
ANTHROPIC_API_KEY=

# Modell für die KI-Analyse (Standard: claude-opus-4-8)
ANFRAGEPILOT_MODEL=claude-opus-4-8

# auto = KI nutzen, wenn ein Key vorhanden ist | on = erzwingen | off = nur Regeln
ANFRAGEPILOT_USE_LLM=auto

# Optional: abweichender Pfad zur SQLite-Datenbank
# ANFRAGEPILOT_DB=/pfad/zu/anfragepilot.db
