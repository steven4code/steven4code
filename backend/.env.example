# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# true  -> use the built-in mock provider (realistic sample data, no credentials
#          needed). The app is fully usable in this mode.
# false -> use the real Google Health API provider (requires the OAuth settings
#          below and a completed login at /auth/login).
USE_MOCK_PROVIDER=true

# ---------------------------------------------------------------------------
# Google Health API / Google OAuth 2.0
# ---------------------------------------------------------------------------
# Create these in the Google Cloud Console (see README.md):
#   APIs & Services -> Credentials -> OAuth 2.0 Client ID (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# OAuth + Google Health API v4 (REST: /v4/users/me/dataTypes/{type}/dataPoints).
OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
HEALTH_API_BASE=https://health.googleapis.com/v4

# Space-separated read-only OAuth scopes. Confirm the exact groups your app needs
# at developers.google.com/health/scopes.
HEALTH_SCOPES=https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly https://www.googleapis.com/auth/googlehealth.sleep.readonly https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly

# ---------------------------------------------------------------------------
# App config
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/health.db
FRONTEND_ORIGIN=http://localhost:5173
# How many days of history to pull on a sync.
SYNC_LOOKBACK_DAYS=90
# Lokale Zeitzone für die "jetzt"-Linie der Tages-Belastung.
TIMEZONE=Europe/Berlin
